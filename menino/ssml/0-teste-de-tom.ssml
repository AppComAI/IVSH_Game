<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xmlns:mstts="https://www.w3.org/2001/mstts" xml:lang="pt-BR">
<voice name="pt-BR-AntonioNeural">Opção A.</voice>
<voice name="pt-BR-LeticiaNeural"><break time="300ms"/><prosody pitch="+0%" rate="+0%">Ops… tô bem, tô bem! Foi só um tombinho. Eu sou o Juninho, moro aqui na beira do Pacajus. Vem cá, deixa eu te explicar a regra dessa parada!</prosody><break time="1200ms"/></voice>
